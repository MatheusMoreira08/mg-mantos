# ============================================================
# MG MANTOS — Variáveis de Ambiente
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA versionar o `.env` real (já está no .gitignore).
# ============================================================

# ------------------------------------------------------------
# CLIENT-SIDE (PUBLICAS) — prefixo VITE_*
# São embutidas no bundle do navegador. Permita apenas chaves
# anônimas/limitadas. NUNCA coloque service_role ou tokens aqui.
# ------------------------------------------------------------

# URL do projeto Supabase
VITE_SUPABASE_URL=

# Chave "anon" do Supabase (Project Settings > API > anon public)
# Limitada pelas Row Level Security (RLS) das tabelas.
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# SERVER-SIDE (SECRETAS) — usadas apenas pelas Serverless
# Functions em /api (nunca chegam ao navegador).
# Configure no painel da Vercel/Netlify/Render, NÃO no .env
# exposto ao front-end.
# ------------------------------------------------------------

# Access token do Mercado Pago (Checkout Pro + webhook)
MERCADOPAGO_ACCESS_TOKEN=

# Token da API Melhor Envio (cálculo real de frete)
MELHOR_ENVIO_TOKEN=

# Chave service_role do Supabase (apenas backend, para o webhook
# atualizar o status do pedido). Jamais exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Lista de origens permitidas (CORS) separadas por vírgula
ALLOWED_ORIGINS=https://mg-mantos.vercel.app

# ------------------------------------------------------------
# EVOLUTION API — notificação via WhatsApp do admin
# Usada só no webhook do Mercado Pago (server-side).
# ------------------------------------------------------------

# URL base da sua instância Evolution API
EVOLUTION_API_URL=https://evolution-api-production-004c.up.railway.app

# Chave (apikey) da Evolution API — SECRETA
EVOLUTION_API_KEY=SUA_API_KEY_AQUI

# Nome da instância que envia as mensagens
EVOLUTION_INSTANCE=mg-mantos

# Número do admin que recebe a notificação (com DDI+DDD, sem símbolos)
SEU_NUMERO_WHATSAPP=5544988215198