# URL do Supabase para conexão ao backend
VITE_SUPABASE_URL=

# Chave anônima pública do Supabase (permissões limitadas)
VITE_SUPABASE_ANON_KEY=

# Token da API Melhor Envio (usado para cálculo real de frete)
MELHOR_ENVIO_TOKEN=

# Access token da sua conta Mercado Pago (obtenha no painel de desenvolvedor)
MERCADOPAGO_ACCESS_TOKEN=

# Chave secreta do Supabase (Project Settings > API > service_role) — NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=
